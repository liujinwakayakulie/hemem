---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const questions = [
  {
    number: "01",
    title: "一年开多少公里，能源差价才真正重要？",
    text: "把年行驶里程放回总拥有成本中，而不是只比较每公里电费与油费。",
  },
  {
    number: "02",
    title: "购置差价需要多久才能被使用成本抵消？",
    text: "观察价格、折旧、保险、补能与维护如何共同改变回收周期。",
  },
  {
    number: "03",
    title: "家充条件会怎样改变结论？",
    text: "区分家充、公共充电与混合补能场景，避免用单一电价代表所有家庭。",
  },
  {
    number: "04",
    title: "结论在哪些条件下会失效？",
    text: "明确参数来源、时间范围与适用边界，让每一个判断都可以被复查。",
  },
];

const publishedResearch = (await getCollection("research", ({ data }) => data.status === "published"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((entry) => ({
    type: entry.data.docType ?? "研究文章",
    title: entry.data.title,
    text: entry.data.description,
    status: entry.data.version ? `已发布 · ${entry.data.version}` : "已发布",
    href: `/research/${entry.id}/`,
  }));

type ResearchItem = { type: string; title: string; text: string; status: string; href?: string };

const plannedResearch: ResearchItem[] = [
  {
    type: "使用指南",
    title: "如何读懂一份家庭用车 TCO 对比",
    text: "从购置、持有到退出三个阶段拆解常见遗漏项和容易误判的指标。",
    status: "提纲准备中",
  },
];

const research = [...publishedResearch, ...plannedResearch];
---
---

<BaseLayout
  title="HEMEM"
  description="HEMEM 家用新能源里程平衡模型：研究家庭年行驶里程、总拥有成本与补能条件如何共同影响油车和新能源车的选择。"
>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="HEMEM 首页">
      <span class="wordmark-mark" aria-hidden="true">H</span>
      <span>HEMEM</span>
    </a>
    <nav aria-label="主要导航">
      <a href="#model">模型</a>
      <a href="#research">研究</a>
      <a href="#method">方法</a>
      <a href="#about">关于</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Household Electric Mobility Equilibrium Model</p>
        <h1 id="hero-title">HEMEM</h1>
        <p class="hero-name">家用新能源里程平衡模型</p>
        <p class="hero-lead">不只比较油价和电价，<br />而是找到属于一个家庭的成本平衡点。</p>
        <p class="hero-summary">
          HEMEM 是一个面向家庭购车决策的研究框架，用可核验的参数分析年行驶里程、购置与折旧、补能条件和持有周期之间的关系。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/self-check/">五分钟决策自检 <span aria-hidden="true">→</span></a>
          <a class="text-link" href="#model">查看模型结构 <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#research">浏览研究计划 <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="hero-facts" aria-label="项目原则">
          <div><dt>对象</dt><dd>家庭用车决策</dd></div>
          <div><dt>方法</dt><dd>情景化 TCO</dd></div>
          <div><dt>原则</dt><dd>来源可查，边界明确</dd></div>
        </dl>
      </div>

      <figure class="model-figure" aria-labelledby="figure-title">
        <figcaption>
          <span id="figure-title">模型视图 / 结构示意</span>
          <span>v0.1</span>
        </figcaption>
        <div class="model-axis" aria-hidden="true">
          <div class="axis-labels"><span>燃油方案</span><span>新能源方案</span></div>
          <div class="axis-track">
            <span class="axis-fill"></span>
            <span class="equilibrium-point"></span>
          </div>
          <div class="equilibrium-label"><span>成本平衡区间</span><strong>取决于家庭参数</strong></div>
        </div>
        <div class="factor-grid">
          <div><span>F1</span><strong>购置与折旧</strong><small>初始差价 / 残值</small></div>
          <div><span>F2</span><strong>补能条件</strong><small>家充 / 公充 / 油价</small></div>
          <div><span>F3</span><strong>使用强度</strong><small>年里程 / 持有年限</small></div>
          <div><span>F4</span><strong>风险边界</strong><small>保险 / 维修 / 波动</small></div>
        </div>
        <p class="figure-note">示意图仅表达模型结构，不代表任何车型的实际盈亏临界点。</p>
      </figure>
    </section>

    <section class="thesis" aria-label="核心观点">
      <p>一个可靠的购车结论，应当能说明</p>
      <strong>用了什么数据、适合谁，以及何时不再成立。</strong>
    </section>

    <section class="section model-section" id="model" aria-labelledby="model-title">
      <div class="section-intro">
        <p class="section-index">01 / 模型</p>
        <h2 id="model-title">HEMEM 试图回答<br />四个具体问题</h2>
        <p>模型不是替用户给出唯一答案，而是把影响判断的变量放在同一张可检查的账表里。</p>
      </div>
      <ol class="question-list">
        {questions.map((question) => (
          <li>
            <span class="question-number">{question.number}</span>
            <div><h3>{question.title}</h3><p>{question.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section research-section" id="research" aria-labelledby="research-title">
      <div class="section-heading-row">
        <div><p class="section-index">02 / 研究索引</p><h2 id="research-title">从模型定义开始，<br />逐步公开验证过程</h2></div>
        <p>以下内容正在准备。正式发布时，每篇研究将注明数据来源、更新时间、假设条件与修订记录。</p>
      </div>
      <div class="research-list">
        {research.map((item, index) => (
          <article>
            <div class="research-meta"><span>{String(index + 1).padStart(2, "0")}</span><span>{item.type}</span></div>
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
            <footer>
              <span class="status-dot" aria-hidden="true"></span>{item.status}
              {item.href && <a class="research-read" href={item.href}>阅读全文 <span aria-hidden="true">↗</span></a>}
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="section method-section" id="method" aria-labelledby="method-title">
      <div class="section-intro">
        <p class="section-index">03 / 方法</p>
        <h2 id="method-title">让结果可以<br />被复算和质疑</h2>
      </div>
      <ol class="method-steps">
        <li><span>01</span><div><h3>定义场景</h3><p>先描述家庭、车辆用途、年里程和持有周期。</p></div></li>
        <li><span>02</span><div><h3>记录来源</h3><p>区分公开数据、用户输入、模型假设和估算值。</p></div></li>
        <li><span>03</span><div><h3>计算区间</h3><p>展示参数变化对结果的影响，而非只给单点结论。</p></div></li>
        <li><span>04</span><div><h3>持续修订</h3><p>保留发布日期、版本号与关键参数变更记录。</p></div></li>
      </ol>
    </section>

    <section class="boundaries" id="about" aria-labelledby="boundaries-title">
      <div>
        <p class="section-index">研究边界</p>
        <h2 id="boundaries-title">这个站点不做什么</h2>
      </div>
      <ul>
        <li>不以单次测算替代完整的个人财务建议</li>
        <li>不把单一车型、地区或年份的结果推广给所有家庭</li>
        <li>不隐藏对结论不利的参数与适用条件</li>
      </ul>
    </section>

    <section class="current-status" aria-labelledby="status-title">
      <p class="section-index">当前状态 / 2026</p>
      <h2 id="status-title">研究框架与网站基础设施正在建立。</h2>
      <p>模型公式、参数来源和首轮情景研究将在完成核验后逐项公开。当前页面中的模型视图是结构示意，不构成购车建议。</p>
    </section>
  </main>

  <footer class="site-footer">
    <div><strong>HEMEM</strong><span>家用新能源里程平衡模型</span></div>
    <p>独立研究项目 · 内容以公开页面的最新版本为准</p>
    <a href="/llms.txt">llms.txt</a>
  </footer>
</BaseLayout>
