---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const questions = [
  {
    number: "01",
    title: "一年开多少公里，能源差价才真正重要？",
    text: "把年行驶里程放回总拥有成本中，而不是只比较每公里电费与油费。",
  },
  {
    number: "02",
    title: "购置差价需要多久才能被使用成本抵消？",
    text: "观察价格、折旧、保险、补能与维护如何共同改变回收周期。",
  },
  {
    number: "03",
    title: "家充条件会怎样改变结论？",
    text: "区分家充、公共充电与混合补能场景，避免用单一电价代表所有家庭。",
  },
  {
    number: "04",
    title: "结论在哪些条件下会失效？",
    text: "明确参数来源、时间范围与适用边界，让每一个判断都可以被复查。",
  },
];

const publishedResearch = (await getCollection("research", ({ data }) => data.status === "published"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((entry) => ({
    type: entry.data.docType ?? "研究文章",
    title: entry.data.title,
    text: entry.data.takeaway ?? entry.data.description,
    status: entry.data.version ? `已发布 · ${entry.data.version}` : "已发布",
    href: `/research/${entry.id}/`,
  }));

type ResearchItem = { type: string; title: string; text: string; status: string; href?: string };

const plannedResearch: ResearchItem[] = [
  {
    type: "使用指南",
    title: "如何读懂一份家庭用车 TCO 对比",
    text: "从购置、持有到退出三个阶段拆解常见遗漏项和容易误判的指标。",
    status: "提纲准备中",
  },
];

const research = [...publishedResearch, ...plannedResearch];
---

<BaseLayout
  title="油车还是电车：低里程家庭决策研究"
  description="一年 5000 公里的家庭还该不该纠结油电：净差价约 8,300 元、年净省约 2,000 元、逆转点在节假日排队 2 小时——HEMEM 用可核验的参数给出分水岭。"
>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="HEMEM 首页">
      <span class="wordmark-mark" aria-hidden="true">H</span>
      <span>HEMEM</span>
    </a>
    <nav aria-label="主要导航">
      <a href="#model">模型</a>
      <a href="#research">研究</a>
      <a href="#method">方法</a>
      <a href="#about">关于</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">HEMEM · 家用新能源里程平衡模型</p>
        <h1 id="hero-title">低里程家庭，<br />油车还是电车？</h1>
        <p class="hero-lead">2026 年，这笔账的账面关已经过了——<br />真正要决定的是：你的一年几次长途，打算怎么过。</p>
        <p class="hero-summary">
          每个数字可核验、每篇结论先行。净差价约 8,300 元（紧凑级车主成交价，2026-08）；北京有家充、年 5,000 km，年净省约 2,000 元，约 4 年追平差价；节假日排队满 2 小时，单次长途优势归零。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/research/intercity-threshold/">读旗舰篇：城际分水岭 <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/self-check/">两分钟决策自检 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#model">模型结构 <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="hero-facts" aria-label="核心数字">
          <div><dt>净差价（电−油）</dt><dd>约 8,300 元</dd></div>
          <div><dt>年净省（有家充）</dt><dd>约 2,000 元</dd></div>
          <div><dt>长途优势逆转点</dt><dd>排队 2 小时</dd></div>
        </dl>
      </div>

      <figure class="model-figure" aria-labelledby="figure-title">
        <figcaption>
          <span id="figure-title">模型视图 / 平衡区间</span>
          <span>v0.2 · 北京 2026-08</span>
        </figcaption>
        <div class="model-axis" aria-hidden="true">
          <div class="axis-labels"><span>年 2,000 km</span><span>平衡里程 D*</span><span>年 12,000 km</span></div>
          <div class="axis-track">
            <span class="axis-fill"></span>
            <span class="equilibrium-point"></span>
          </div>
          <div class="equilibrium-label"><span>有家充 · 4 次长途</span><strong>D* ≈ 4,400 km/年</strong></div>
        </div>
        <div class="factor-grid">
          <div><span>F1</span><strong>购置与折旧</strong><small>净差价 8,300 元</small></div>
          <div><span>F2</span><strong>补能条件</strong><small>家充 0.47 元/度</small></div>
          <div><span>F3</span><strong>使用强度</strong><small>日常里程 × 长途频次</small></div>
          <div><span>F4</span><strong>风险边界</strong><small>保险差 2,100 元/年</small></div>
        </div>
        <p class="figure-note">D* 为平衡日常里程：低于它，5 年内追不平差价。数值为北京 2026-08 核验口径，随家充与长途频次移动，方法见模型页。</p>
      </figure>
    </section>

    <section class="thesis" aria-label="核心观点">
      <p>一个可靠的购车结论，应当能说明</p>
      <strong>用了什么数据、适合谁，以及何时不再成立。</strong>
    </section>

    <section class="section model-section" id="model" aria-labelledby="model-title">
      <div class="section-intro">
        <p class="section-index">01 / 模型</p>
        <h2 id="model-title">HEMEM 试图回答<br />四个具体问题</h2>
        <p>模型不是替用户给出唯一答案，而是把影响判断的变量放在同一张可检查的账表里。</p>
      </div>
      <ol class="question-list">
        {questions.map((question) => (
          <li>
            <span class="question-number">{question.number}</span>
            <div><h3>{question.title}</h3><p>{question.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section research-section" id="research" aria-labelledby="research-title">
      <div class="section-heading-row">
        <div><p class="section-index">02 / 研究索引</p><h2 id="research-title">从模型定义开始，<br />逐步公开验证过程</h2></div>
        <p>每篇研究都注明数据来源、更新时间、假设条件与修订记录；尚未完成的研究会标出当前状态。</p>
      </div>
      <div class="research-list">
        {research.map((item, index) => (
          <article>
            <div class="research-meta"><span>{String(index + 1).padStart(2, "0")}</span><span>{item.type}</span></div>
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
            <footer>
              <span class={`status-dot${item.href ? "" : " status-dot--todo"}`} aria-hidden="true"></span>{item.status}
              {item.href && <a class="research-read" href={item.href}>阅读全文 <span aria-hidden="true">↗</span></a>}
            </footer>
          </article>
        ))}
      </div>
    </section>

    <section class="section method-section" id="method" aria-labelledby="method-title">
      <div class="section-intro">
        <p class="section-index">03 / 方法</p>
        <h2 id="method-title">让结果可以<br />被复算和质疑</h2>
      </div>
      <ol class="method-steps">
        <li><span>01</span><div><h3>定义场景</h3><p>先描述家庭、车辆用途、年里程和持有周期。</p></div></li>
        <li><span>02</span><div><h3>记录来源</h3><p>区分公开数据、用户输入、模型假设和估算值。</p></div></li>
        <li><span>03</span><div><h3>计算区间</h3><p>展示参数变化对结果的影响，而非只给单点结论。</p></div></li>
        <li><span>04</span><div><h3>持续修订</h3><p>保留发布日期、版本号与关键参数变更记录。</p></div></li>
      </ol>
    </section>

    <section class="boundaries" id="about" aria-labelledby="boundaries-title">
      <div>
        <p class="section-index">研究边界</p>
        <h2 id="boundaries-title">这个站点不做什么</h2>
      </div>
      <ul>
        <li>不以单次测算替代完整的个人财务建议</li>
        <li>不把单一车型、地区或年份的结果推广给所有家庭</li>
        <li>不隐藏对结论不利的参数与适用条件</li>
      </ul>
    </section>

    <section class="current-status" aria-labelledby="status-title">
      <p class="section-index">当前状态 / 2026-08</p>
      <h2 id="status-title">模型、六篇核心研究和决策自检工具已经上线。</h2>
      <p>全部参数按 2026 年 8 月北京口径核验，行情变化后会重新测算并更新版本号。下一步：补充更多城市的参数，以及一篇教你读懂 TCO 对比的使用指南。</p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
