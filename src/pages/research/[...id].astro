---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ResearchLayout from "../../layouts/ResearchLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("research", ({ data }) => data.status === "published");

  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"research">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text }));
---

<ResearchLayout
  title={entry.data.title}
  description={entry.data.description}
  takeaway={entry.data.takeaway}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  sources={entry.data.sources}
  version={entry.data.version}
  docType={entry.data.docType}
  toc={toc}
>
  <Content />
</ResearchLayout>
