---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="页面不存在"
  description="HEMEM 研究站的 404 页面：这个地址没有对应内容，可以从首页、研究索引或决策自检工具继续。"
  noindex
>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="HEMEM 首页">
      <span class="wordmark-mark" aria-hidden="true">H</span>
      <span>HEMEM</span>
    </a>
    <nav aria-label="主要导航"><a href="/#research">研究索引</a><a href="/self-check/">决策自检</a></nav>
  </header>

  <main class="not-found" id="main">
    <p class="section-index">404</p>
    <h1>这一页不存在</h1>
    <p>这个地址没有对应内容，可能是链接失效或输入有误。站点内容都在首页、研究索引和决策自检工具里。</p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">回到首页</a>
      <a class="text-link" href="/#research">浏览研究索引 <span aria-hidden="true">↗</span></a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style is:global>
  .not-found {
    display: grid;
    min-height: calc(100vh - 220px);
    align-content: center;
    justify-items: center;
    padding: 80px 24px;
    background: var(--paper);
    text-align: center;
  }
  .not-found h1 {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: 54px;
    font-weight: 600;
    line-height: 1.2;
  }
  .not-found > p:not(.section-index) {
    max-width: 520px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .not-found-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
  }
  @media (max-width: 620px) {
    .not-found {
      min-height: auto;
      padding-block: 96px;
    }
    .not-found h1 {
      font-size: 38px;
    }
    .not-found-actions {
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
